{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "skipLibCheck": true, "strict": false,
    "module": "NodeNext", "moduleResolution": "NodeNext", "target": "ES2024",
    "resolveJsonModule": true, "maxNodeModuleJsDepth": 0, "types": ["node"]
  },
  "include": ["src/**/*.mjs", "scripts/**/*.mjs"]
}
